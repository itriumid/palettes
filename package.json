{
  "name": "@itrium/palettes",
  "version": "0.2.0",
  "description": "Itrium's color palettes, Svelte pickers for the theme and palette, and the contrast check every palette passes",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itriumid/palettes.git"
  },
  "homepage": "https://github.com/itriumid/palettes#readme",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./palettes": {
      "types": "./dist/palettes.d.ts",
      "default": "./dist/palettes.js"
    },
    "./check": {
      "types": "./dist/check.d.ts",
      "default": "./dist/check.js"
    },
    "./palettes.css": "./dist/palettes.css"
  },
  "scripts": {
    "build": "svelte-package --input src/lib --output dist",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "pnpm build && node --test \"tests/*.test.mjs\""
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/package": "^2.5.8",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "~6.0.3"
  }
}
